# Copiaza acest fisier ca .env.raspberry pe Raspberry Pi daca vrei setari fixe.
# Build recomandat:
# npm run build -- --mode raspberry

# De obicei nu trebuie setat: frontend-ul incearca mai intai API-ul pe acelasi
# origin ca pagina curenta, apoi face fallback la portul 8000 pe acelasi host.
# Exemple:
# http://192.168.2.102:8080/ incearca http://192.168.2.102:8080/api/
# si apoi http://192.168.2.102:8000/api/ daca primul URL nu raspunde ca API.
# http://100.75.19.22:8080/ face acelasi lucru pentru IP-ul Tailscale.
# Activeaza linia de mai jos doar daca backend-ul este mereu pe un singur URL.
# Poti pune si mai multe URL-uri separate prin virgula, in ordinea dorita.
# VITE_API_BASE_URL=http://192.168.2.102:8080/api/,http://192.168.2.102:8000/api/

# Aceste URL-uri apar ca sugestii in fereastra Instalare / QR.
VITE_INSTALL_URLS=http://192.168.2.102:8080/,http://100.75.19.22:8080/
