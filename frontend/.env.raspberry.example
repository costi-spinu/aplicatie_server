# Copiaza acest fisier ca .env.raspberry pe Raspberry Pi daca vrei setari fixe.
# Build recomandat:
# npm run build -- --mode raspberry

# De obicei nu trebuie setat: frontend-ul calculeaza automat API-ul ca
# http://<hostul-din-browser>:8000/api/
# Exemple:
# http://192.168.2.102:8080/ foloseste automat http://192.168.2.102:8000/api/
# http://100.75.19.22:8080/ foloseste automat http://100.75.19.22:8000/api/
# Daca vrei fallback explicit intre reteaua locala si Tailscale:
# VITE_API_BASE_URL=http://100.75.19.22:8000/api/,http://192.168.2.102:8000/api/

# Aceste URL-uri apar ca sugestii in fereastra Instalare / QR.
VITE_INSTALL_URLS=http://192.168.2.102:8080/,http://100.75.19.22:8080/

# Scriptul scripts/mobile-install.sh poate construi automat ambele URL-uri:
# APP_HOST=192.168.2.102 TAILSCALE_HOST=100.75.19.22 ./scripts/mobile-install.sh
# sau, pentru Tailscale HTTPS / MagicDNS:
# APP_HOST=192.168.2.102 TAILSCALE_ORIGIN=https://raspberry.tailnet.ts.net ./scripts/mobile-install.sh
